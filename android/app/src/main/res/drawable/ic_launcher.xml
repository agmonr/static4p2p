    <path android:fillColor="#4CAF50" android:pathData="M40,30 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0" />
    <path android:fillColor="#2E7D46" android:pathData="M32,34 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
    <path android:fillColor="#2E7D46" android:pathData="M56,34 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
