<?xml version="1.0" encoding="utf-8"?>
<!-- Oak tree on the govapiportal forest palette, since this app is the
     launcher for "ארגז כלים לפעיל חברתי" (govapiportal's toolbox) + chat.
     A single flat vector rather than a dual-layer adaptive icon - works
     identically on every supported API level (minSdk 24) with no PNG
     rasterization needed. -->
