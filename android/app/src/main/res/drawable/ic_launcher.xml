    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:fillColor="#1B5E34" android:pathData="M0,0h108v108h-108z" />

    <!-- trunk -->
    <path android:fillColor="#A1725C" android:pathData="M50,70 L58,70 L60,86 L48,86 Z" />

    <!-- canopy: cluster of overlapping circles for a lumpy oak-crown silhouette -->
